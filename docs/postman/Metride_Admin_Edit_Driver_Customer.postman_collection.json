{
  "info": {
    "_postman_id": "c501d53c-3932-423f-bc71-6d5db5bad350",
    "name": "Metride — Admin: Edit Driver & Customer",
    "description": "Admin endpoints to edit driver and customer (user) information. All requests need an admin bearer token (`adminToken`), which **Admin Login** saves for you. Allowed roles: `admin`, `operations`.\n\nThe response envelope is `{ status_code, status, message, results }`. Validation failures return HTTP 422 with `results` as an array of `{ message, rule, field }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "auth": {
            "type": "noauth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.results?.accessCredentials?.token) pm.environment.set('adminToken', body.results.accessCredentials.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins/authentication/authenticate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admins",
                "authentication",
                "authenticate"
              ]
            }
          },
          "response": []
        }
      ]
    },
