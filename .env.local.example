# Copy this file to .env.local for isolated local development.
# Adonis loads .env.local before .env, so these values override remote DB settings.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=local
DB_PASSWORD=local
DB_DATABASE=metride_local

# Keep background jobs in-process locally; Redis is not required for seed development.
QUEUE_DRIVER=sync
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
